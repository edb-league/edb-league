# URL interna da API FastAPI (usada pelo servidor Next.js e pelo proxy /api).
API_URL=http://127.0.0.1:8000
# URL pública do site (links de pré-visualização). Na Vercel, se ficar vazia, vale o domínio de produção do projeto.
# As imagens de pré-visualização (opengraph-image.tsx) usam fontes e brasão embutidos; para regerar: node scripts/gen-og-assets.mjs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
